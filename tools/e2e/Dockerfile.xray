# Build the proxy server image from the exact official Xray release the
# repository catalog already pins, so the lane trusts the same release evidence
# the product does rather than a third-party image.
#
# The caller passes the version and its verified SHA-256; the build fails if the
# downloaded archive does not match.
ARG E2E_BASE_IMAGE
FROM ${E2E_BASE_IMAGE}

ARG XRAY_VERSION
ARG XRAY_SHA256
ARG XRAY_ASSET

RUN set -eu; \
    apk add --no-cache ca-certificates unzip curl; \
    curl -fsSL -o /tmp/xray.zip \
      "https://github.com/XTLS/Xray-core/releases/download/v${XRAY_VERSION}/${XRAY_ASSET}"; \
    echo "${XRAY_SHA256}  /tmp/xray.zip" | sha256sum -c -; \
    unzip -j /tmp/xray.zip xray -d /usr/local/bin; \
    chmod 0755 /usr/local/bin/xray; \
    rm -f /tmp/xray.zip; \
    /usr/local/bin/xray version

ENTRYPOINT ["/usr/local/bin/xray"]
